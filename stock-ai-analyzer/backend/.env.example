APP_NAME="Stock AI Analyzer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker, docker-compose.yml overrides the connection hosts, credentials and secrets.
# The values below let `php artisan` run on the Windows host against the published ports.
# Run `py infra/scripts/init_env.py` from the repo root to fill the blanks.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=stock_ai
DB_USERNAME=stock_ai
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must exceed the longest job timeout (AnalyzeChartJob: 900 s).
REDIS_QUEUE_RETRY_AFTER=960
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@stock-ai.local"
MAIL_FROM_NAME="${APP_NAME}"

ENGINE_URL=http://localhost:8100
ENGINE_HMAC_SECRET=

OWNER_NAME=Owner
OWNER_EMAIL=owner@stock-ai.local
OWNER_PASSWORD=

# NEPSE market data from merolagani (docs/market-data.md). Every value has a working default in
# config/stock_ai.php; these are here to be found when you want to change one.
MEROLAGANI_URL=https://eng.merolagani.com
# Bonus- and rights-adjusted prices. Set false only to compare against an unadjusted chart.
MEROLAGANI_ADJUSTED=true
# Days a routine run re-asks for, covering a late or restated bar.
MEROLAGANI_LOOKBACK_DAYS=10
MEROLAGANI_HISTORY_START=2000-01-01
# Seconds between symbols in a scheduled run.
MEROLAGANI_SPACING_SECONDS=2

# Sharesansar: the instruments merolagani does not chart, plus turnover (docs/market-data.md).
SHARESANSAR_URL=https://www.sharesansar.com
SHARESANSAR_LOOKBACK_DAYS=10

# The analyst LLM writes the narrative (docs/analyst.md). These are engine settings; the engine
# reads them from its own environment, listed here so they are findable.
# ANALYST_ENABLED=true
# ANALYST_TIMEOUT_SECONDS=600
