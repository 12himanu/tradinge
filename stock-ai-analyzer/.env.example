# Docker Compose settings for the local stack. Copy to .env and fill in the blanks.
# Values here are shared by several services; app-specific settings live in backend/.env.

# Host ports (container ports are fixed). Defaults avoid 5432/5433/6379/6380, which are
# commonly taken by other local databases.
FRONTEND_PORT=3000
BACKEND_PORT=8000
ENGINE_PORT=8100
POSTGRES_PORT=5442
REDIS_PORT=6390

# PostgreSQL
POSTGRES_DB=stock_ai
POSTGRES_USER=stock_ai
POSTGRES_PASSWORD=

# Shared secret for Laravel -> AI engine request signing (HMAC-SHA256), at least 32 chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENGINE_HMAC_SECRET=

# Ollama runs natively on the Windows host for GPU access.
OLLAMA_HOST=http://host.docker.internal:11434
# gpu_4gb | gpu_8gb | gpu_16gb | cpu  (see ai-engine/config/models.yaml)
MODEL_PROFILE=gpu_4gb

# Before analysing, the vision model reads the chart's title and the run is refused if the
# screenshot is of a different company than the symbol it was requested for. One extra model load
# per analysis; false trusts whatever ticker was typed.
SYMBOL_CHECK_ENABLED=true

# Local owner account created by the seeder
OWNER_NAME=Owner
OWNER_EMAIL=owner@stock-ai.local
OWNER_PASSWORD=
